# Copy this file to .env and fill in real values.
# src/lib/env.ts validates all of these at boot and fails fast if invalid/missing.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Database (MySQL 8, via Prisma)
# ---------------------------------------------------------------------------
DATABASE_URL="mysql://user:password@localhost:3306/sajdhajlo"

# ---------------------------------------------------------------------------
# Auth.js (NextAuth)
# ---------------------------------------------------------------------------
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ---------------------------------------------------------------------------
# Phone OTP (MSG91)
# ---------------------------------------------------------------------------
MSG91_AUTH_KEY=""
MSG91_SENDER_ID=""
MSG91_OTP_TEMPLATE_ID=""

# ---------------------------------------------------------------------------
# Payments (PayU hosted checkout — active gateway)
# ---------------------------------------------------------------------------
PAYU_KEY=""
PAYU_SALT=""
PAYU_ENV="TEST"

# Legacy Cashfree gateway, retained for historical payments/webhooks
CASHFREE_APP_ID=""
CASHFREE_SECRET_KEY=""
CASHFREE_ENV="SANDBOX"

# ---------------------------------------------------------------------------
# Payments (Razorpay) — dormant, kept configured for a one-line revert
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# Media storage - Cloudinary OR AWS S3 + CloudFront (pick one set)
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="ap-south-1"
AWS_S3_BUCKET=""
AWS_CLOUDFRONT_DOMAIN=""

# ---------------------------------------------------------------------------
# Email (Resend OR AWS SES OR Gmail SMTP)
# ---------------------------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="SajDhajLo <no-reply@sajdhajlo.com>"
# Gmail SMTP fallback, used when RESEND_API_KEY is empty. GMAIL_APP_PASSWORD
# is an "app password" generated from the Gmail account's security settings
# (Google Account > Security > 2-Step Verification > App passwords) — never
# the account's real login password.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# ---------------------------------------------------------------------------
# WhatsApp Cloud API
# ---------------------------------------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_VERIFY_TOKEN=""

# ---------------------------------------------------------------------------
# Redis (Upstash) - rate limiting, OTP storage, search cache
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ---------------------------------------------------------------------------
# SEO / indexing / analytics (wired up in Phase 7)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GA4_MEASUREMENT_ID=""
GOOGLE_SITE_VERIFICATION=""
INDEXNOW_KEY=""
GOOGLE_INDEXING_API_CLIENT_EMAIL=""
GOOGLE_INDEXING_API_PRIVATE_KEY=""

# ---------------------------------------------------------------------------
# Observability (wired up in Phase 8)
# ---------------------------------------------------------------------------
SENTRY_DSN=""
